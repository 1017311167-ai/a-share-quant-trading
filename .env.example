# ===== 环境变量配置模板 =====
# 使用方法：
#   1. 复制本文件为 .env：cp .env.example .env
#   2. 把下面的占位符换成你自己的真实值
#   3. 代码里读取：from dotenv import load_dotenv; load_dotenv()
#      os.getenv("SMTP_HOST")
# 注意：
#   - .env 已被 .gitignore 忽略，不会提交到仓库，密钥不会泄露
#   - 值不要加引号，等号两边不要加空格

# ---------- 推送渠道开关（true 开启 / false 关闭） ----------
NOTIFY_EMAIL=true
NOTIFY_WECOM=true

# ---------- 邮件通知（回测完成 / 交易信号 / 风控告警自动发邮件） ----------
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SSL=true
# 发件邮箱
SMTP_USER=your_email@qq.com
# QQ/163 邮箱请使用「授权码」而不是登录密码
SMTP_PASSWORD=your_smtp_auth_code
# 收件人，多个用英文逗号分隔
MAIL_TO=receiver1@example.com,receiver2@example.com

# ---------- 企业微信机器人（群消息 Webhook 推送） ----------
WECOM_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ---------- 钉钉机器人（群消息 Webhook 推送） ----------
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxxxxxxxxxxx
# 加签密钥（机器人开启「加签」安全设置时才需要）
DINGTALK_SECRET=SECxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- 数据源 Token（备用付费 / 授权数据接口） ----------
TUSHARE_TOKEN=your_tushare_token
JQDATA_USER=your_joinquant_username
JQDATA_PASSWORD=your_joinquant_password

# ---------- 其他 ----------
LOG_LEVEL=INFO

# ---------- 行情数据目录（可选；不填使用项目 data/ 目录） ----------
# ABACKTEST_CACHE_DIR=D:\\abacktest_cache
# ABACKTEST_SNAPSHOT_DIR=D:\\abacktest_snapshots
# ABACKTEST_CALENDAR_DIR=D:\\abacktest_cache\\calendar
# ABACKTEST_EXPERIMENT_DIR=D:\\abacktest_experiments
# 运行代码版本号；不填时自动读取当前 Git 提交短哈希
# ABACKTEST_CODE_VERSION=

# ---------- QMT 券商交易（迅投 miniQMT，xtquant SDK） ----------
# 当前阶段固定为模拟盘，任何真实资金模式都会被程序拒绝
TRADING_STAGE=paper
# QMT 客户端安装目录下的 userdata 文件夹路径（Windows 路径用 \\ 分隔）
QMT_USERDATA_PATH=D:\\迅投极速交易终端\\userdata_mini
# 资金账号（模拟账户填模拟账号；账号和路径绝不能在代码里硬编码）
QMT_ACCOUNT=your_qmt_account
# 账号类型，默认股票账户 STOCK（一般不用改）
QMT_ACCOUNT_TYPE=STOCK
# SIMULATION=模拟；REAL 当前禁止运行
QMT_TRADING_MODE=SIMULATION
QMT_ALLOW_REAL_TRADING=false
# 会话 ID：同一账号同时跑多个程序时需要区分，不填自动生成
# QMT_SESSION_ID=123456
